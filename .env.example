# Переменные для docker compose. Файл необязателен: у всех значений есть
# дефолты прямо в docker-compose.yaml. Скопируйте в .env, чтобы переопределить.
#
# Настройки самого приложения живут в src/.env.example — в контейнеры они
# передаются через блок environment в docker-compose.yaml, а не отсюда.

# Учётные данные PostgreSQL (используются и сервисом postgres, и строкой
# подключения приложения — меняются только вместе)
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Порты, публикуемые на хосте
APP_PORT=<port>
PROMETHEUS_PORT=<port>

# Уровень логирования всех контейнеров приложения
LOG_LEVEL=<DEBUG|INFO|WARNING|ERROR>
